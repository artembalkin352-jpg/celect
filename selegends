-- Функция загрузки скрипта
local function LoadScript()
    v83.Text = "Загрузка..."
    v85.Text = "Загрузка скрипта..."
    
    task.spawn(function()
        local success, result = pcall(function()
            return game:HttpGet(v4)
        end)
        
        if not success then
            v85.Text = "Ошибка загрузки: " .. tostring(result)
            v83.Text = "Загрузить скрипт"
            return
        end
        
        local scriptContent = result
        v85.Text = "Компиляция скрипта..."
        
        local compiled, err = loadstring(scriptContent)
        if not compiled then
            v85.Text = "Ошибка компиляции: " .. tostring(err)
            v83.Text = "Загрузить скрипт"
            return
        end
        
        v85.Text = "Запуск скрипта..."
        
        local execSuccess, execErr = pcall(compiled)
        if not execSuccess then
            v85.Text = "Ошибка выполнения: " .. tostring(execErr)
            v83.Text = "Загрузить скрипт"
            return
        end
        
        v85.Text = "Скрипт успешно загружен!"
        v83.Text = "Готово"
        task.wait(1)
        v9:Destroy()
    end)
end

